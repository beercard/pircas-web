# -----------------------------------------------------------------------------
# PIRCAS Aberturas — variables de entorno
# Copiá este archivo a `.env` y completá los valores. NUNCA subas `.env` a git.
# -----------------------------------------------------------------------------

# --- Base de datos -----------------------------------------------------------
# Local (docker-compose.dev.yml): postgres://pircas:pircas@localhost:5432/pircas
# En producción con docker-compose.yml se arma sola a partir de POSTGRES_*.
DATABASE_URL=postgres://pircas:pircas@localhost:5432/pircas
# Usadas por docker-compose.yml para crear la base (usá una contraseña fuerte)
POSTGRES_USER=pircas
POSTGRES_PASSWORD=pircas
POSTGRES_DB=pircas

# --- Payload CMS -------------------------------------------------------------
# Cadena aleatoria larga (ej: `openssl rand -hex 32`). Firma sesiones y tokens.
PAYLOAD_SECRET=
# Secreto para el modo borrador / vista previa (cadena aleatoria)
PREVIEW_SECRET=

# --- Sitio ---------------------------------------------------------------------
# URL pública sin barra final. Se usa para canonical, sitemap, OpenGraph y CSRF.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (SMTP, cualquier proveedor: Zimbra, Brevo, Resend, etc.) -----------
SMTP_HOST=
SMTP_PORT=587
# true para el puerto 465 (TLS implícito); false para 587/25 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Remitente, ej: "PIRCAS Aberturas <no-reply@pircas.com.ar>"
SMTP_FROM=
# Destinatarios de avisos de nuevas consultas (separados por coma).
# Se suman a los configurados en el panel (Configuración > Formularios).
LEADS_NOTIFICATION_EMAIL=

# --- Cloudflare Turnstile (anti-spam) -----------------------------------------
# En producción son obligatorias. En desarrollo, si están vacías, se omite la
# verificación (con aviso en el log).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analítica (valores por defecto; el panel puede sobrescribirlos) ----------
GOOGLE_TAG_MANAGER_ID=
GA4_MEASUREMENT_ID=
META_PIXEL_ID=

# --- WhatsApp (valor por defecto; se edita en Configuración del sitio) ----------
# Formato internacional sin "+" ni espacios, ej: 5493425903814
WHATSAPP_NUMBER=

# --- Opcional ------------------------------------------------------------------
# Nivel de logs del servidor: fatal | error | warn | info | debug
LOG_LEVEL=info
# Envíos permitidos por IP cada 10 minutos en cada formulario público
FORM_RATE_LIMIT=5
# URL interna de la app para el proxy de redirecciones (por defecto http://127.0.0.1:$PORT)
INTERNAL_URL=
# Carpeta de imágenes subidas (por defecto ./public/media)
MEDIA_DIR=
# Cargar GTM/GA4/Pixel también en desarrollo (por defecto solo en producción)
ANALYTICS_IN_DEV=false
# Primer super-admin creado por `pnpm seed` (solo si la base no tiene usuarios)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Días que se conservan los backups de scripts/backup.sh
BACKUP_KEEP_DAYS=30

# Solo desarrollo local: entra al panel sin contraseña con este usuario (nunca en producción)
# PAYLOAD_DEV_AUTOLOGIN_EMAIL=
